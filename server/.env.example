PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# replay is the stable demo default; set opensky to try live OpenSky ingestion.
AIRCRAFT_SOURCE=replay
AIRCRAFT_POLL_MS=10000

# MongoDB audit database. If unavailable, the API falls back to in-memory audit logs.
MONGODB_URI=

# Mumbai/BOM-style OpenSky bounding box.
OPENSKY_LAMIN=16.0
OPENSKY_LAMAX=23.5
OPENSKY_LOMIN=68.0
OPENSKY_LOMAX=77.5

# Optional OpenSky credentials.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Lightweight OpenSky model training.
TRAINING_SAMPLES=12
TRAINING_INTERVAL_MS=60000
CONFLICT_LOOKAHEAD_MINUTES=10
CONFLICT_LATERAL_NM=5
CONFLICT_VERTICAL_FT=1000
