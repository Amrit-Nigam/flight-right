# Secrets and local configuration
secrets/*
!secrets/.gitkeep
# Also cover a secrets/ directory nested under server/ or client/, which the
# rooted pattern above would miss once the backend grows its own config.
**/secrets/*
!**/secrets/.gitkeep
.env

# Python environments and bytecode
venv/
.venv/
__pycache__/
*.pyc
*.py[cod]
*$py.class

# ML data: retain directory placeholders only, with ONE exception.
#
# The raw OpenSky session files ARE tracked. They are the only irreplaceable thing in
# this repository: twelve days of credit-limited collection, and the free OpenSky
# interface serves live traffic only -- it will not sell last week back. Everything
# else under data/ and every saved model is regenerated from these files in about
# twenty minutes by ml_pipeline/run_pipeline.py, and four of those stages reproduce
# bit-for-bit, so they stay ignored. About 16 MB total, public data, nothing sensitive.
ml_pipeline/data/raw/*
!ml_pipeline/data/raw/.gitkeep
!ml_pipeline/data/raw/*.parquet
ml_pipeline/data/processed/*
!ml_pipeline/data/processed/.gitkeep
ml_pipeline/data/synthetic/*
!ml_pipeline/data/synthetic/.gitkeep
ml_pipeline/data/replay/*
!ml_pipeline/data/replay/.gitkeep

# Locally trained model artifacts: retain directory placeholder only
server/app/ml/saved_models/*
!server/app/ml/saved_models/.gitkeep

# OS and editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# OpenSky credential exports (contain live API secrets)
OpenSky Credentials_*.json

# Local env backups and file backups (may contain secrets)
.env.*
!.env.example
*.bak
*.bak[0-9]
*.backup_*

# Node dependencies (client and server)
node_modules/

# Training run logs are large and per-machine; the markdown reports beside them are kept.
ml_pipeline/reports/logs/
