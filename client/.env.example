# Optional browser API endpoint; defaults to the local backend.
VITE_API_URL=http://127.0.0.1:8000

# Optional replacement raster tile provider (including any provider-required token).
# Public OpenStreetMap is the default best-effort demo service. Follow its usage policy.
# Set VITE_MAP_ATTRIBUTION to the provider's required attribution HTML as well.
# VITE_MAP_TILE_URL=https://your-provider.example/{z}/{x}/{y}.png
